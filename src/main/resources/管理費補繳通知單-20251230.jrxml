	<dataset name="Dataset1" uuid="18f8f35c-73be-40cf-978d-98dba4e4d3f0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="287"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="706"/>
		<parameter name="sql_doortablet" class="java.lang.String"/>
		<parameter name="sql_receiver" class="java.lang.String"/>
		<parameter name="sql_this_date" class="java.lang.String"/>
		<query language="SQL"><![CDATA[WITH items AS (
SELECT 
ROW_NUMBER() OVER (PARTITION BY  b.doortablet ORDER BY b.od,b.zyymm,b.payment_rmk) as item_id
,(CASE WHEN payment_rmk IS NULL OR payment_rmk == "" THEN "" 
WHEN payment_rmk = '本期管理費' THEN payment_rmk||"，民國"||zyear||"年"||zmonth||"月份，應繳納社區管理費"||adjusted_management_fee||"元、汽車清潔費"||car_cleaning_fee||"元、機車清潔費"||motorcycle_cleaning_fee||"元，本項小計共"||monthly_management_fee||"元。" 
WHEN other_amount > 0 THEN payment_rmk||" "||other_amount||"元。" 
WHEN other_amount < 0 THEN payment_rmk||"抵減 "||other_amount||"元。" 
ELSE " " 
END) as description
,CASE WHEN other_amount IS NOT NULL THEN other_amount ELSE monthly_management_fee END AS fee
FROM (
SELECT a.doortablet,a.zyymm,a.payment_rmk,a.other_amount,a.reversed
,b.monthly_management_fee,b.receiver_name,b.adjusted_management_fee,b.car_cleaning_fee,b.motorcycle_cleaning_fee
,CAST(SUBSTRING(a.zyymm, 1, INSTR(a.zyymm, '-')-1) as INT) - 1911 as zyear
,CAST(SUBSTR(a.zyymm, INSTR(a.zyymm, '-')+1,2)  as INT)  as zmonth
,CASE WHEN payment_rmk = '本期管理費' THEN 0 ELSE 1 END as od
FROM management_fees_receivable as a
JOIN doortablet_info AS b ON (b.doortablet = a.doortablet)
WHERE  a.doortablet =  $P{sql_doortablet} 
--WHERE a.doortablet = '六福路247巷3號二樓'
AND a.zyymm <= $P{sql_this_date} 
AND a.reversed = 0
AND ( $P{sql_receiver} IS NULL OR b.receiver_name =  $P{sql_receiver})
) as b
ORDER BY b.doortablet,b.od,b.zyymm,b.payment_rmk
)
SELECT item_id||"."||description as description,fee
FROM items
 --UNION ALL
 --SELECT "◆◆◆◆◆ 合計應繳納管理費共"||(sum(fee))||"元。◆◆◆◆◆" as description
 --FROM items
  
]]></query>
		<field name="description" class="java.lang.Object">
			<property name="com.jaspersoft.studio.field.name" value="description"/>
			<property name="com.jaspersoft.studio.field.label" value="description"/>
		</field>
		<field name="fee" class="java.lang.Object">
			<property name="com.jaspersoft.studio.field.name" value="fee"/>
			<property name="com.jaspersoft.studio.field.label" value="fee"/>
		</field>
		<variable name="fee_sum" calculation="Sum" class="java.math.BigDecimal">
			<expression><![CDATA[$F{fee}]]></expression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
	</dataset>
	<parameter name="owner_doorplate" class="java.lang.String">
		<defaultValueExpression><![CDATA["六福路247巷1號七樓"]]></defaultValueExpression>
	</parameter>
	<parameter name="receiver" class="java.lang.String"/>
	<parameter name="this_date" class="java.lang.String"/>
	<query language="sql"><![CDATA[
SELECT owner_name,strftime('%Y', my_date) || '年' ||
       strftime('%m', my_date) || '月' ||
       '20日' AS deadline_date
FROM (
SELECT owner_name ,date( $P{this_date} ) AS my_date
FROM doortablet_info
WHERE doortablet =  $P{owner_doorplate} 
) AS m
]]></query>
	<field name="owner_name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="owner_name"/>
		<property name="com.jaspersoft.studio.field.label" value="owner_name"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="doortablet_info"/>
	</field>
	<field name="deadline_date" class="java.lang.Object">
		<property name="com.jaspersoft.studio.field.name" value="deadline_date"/>
		<property name="com.jaspersoft.studio.field.label" value="deadline_date"/>
	</field>
	<variable name="receiver_name" class="java.lang.String">
		<expression><![CDATA[$P{receiver}==null?$F{owner_name}:$P{receiver}]]></expression>
	</variable>
